# Copy this file to .env (git-ignored) and fill in what you need.
# Never commit .env or put a real password in this example file.
#
# Default below: local Unix socket + your Linux user + no password (peer
# authentication), which is how psql connects in WSL.
# DB_HOST is the socket FOLDER: Ubuntu's PostgreSQL uses /var/run/postgresql,
# but conda's psycopg looks in /tmp unless told otherwise.
# For a TCP connection instead (e.g. DBeaver style): DB_HOST=localhost, DB_PORT=5432,
# and DB_USER / DB_PASSWORD.
DB_NAME=portfolio_tracker
DB_USER=
DB_PASSWORD=
DB_HOST=/var/run/postgresql
DB_PORT=
